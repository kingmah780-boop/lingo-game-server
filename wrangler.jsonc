{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingo-game-server",
  "main": "Worker.js",
  "compatibility_date": "2026-11-24",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
